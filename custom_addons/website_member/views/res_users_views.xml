<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_directory" model="ir.ui.view">
        <field name="name">res.users.form.members</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Members page" name="member_directory">
                    <field name="members_published"/>
                    <field name="members_subtitle"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Club Plongee" name="dive_club">
                    <group>
                        <group string="Identite">
                            <field name="dive_firstname"/>
                            <field name="dive_lastname"/>
                            <field name="dive_gender"/>
                            <field name="dive_birthday"/>
                            <field name="dive_member_since"/>
                            <field name="dive_profession"/>
                            <field name="dive_is_plongeur"/>
                            <field name="dive_is_hsa"/>
                        </group>
                        <group string="Telephones club">
                            <field name="dive_phone_home"/>
                            <field name="dive_phone_work"/>
                        </group>
                    </group>
                    <group>
                        <group string="LIFRAS">
                            <field name="dive_brevet"/>
                            <field name="dive_lifras_id"/>
                        </group>
                        <group string="Urgence / Medical">
                            <field name="dive_contact_name"/>
                            <field name="dive_contact_phone"/>
                            <field name="dive_last_medical"/>
                            <field name="dive_last_ecg"/>
                        </group>
                    </group>
                    <group string="Brevets">
                        <group>
                            <field name="dive_brevet_date_1"/>
                            <field name="dive_brevet_date_2"/>
                            <field name="dive_brevet_date_3"/>
                            <field name="dive_brevet_date_4"/>
                        </group>
                        <group>
                            <field name="dive_brevet_date_am"/>
                            <field name="dive_brevet_date_mc"/>
                            <field name="dive_brevet_date_mf"/>
                            <field name="dive_brevet_date_mn"/>
                        </group>
                    </group>
                    <group string="Specialites">
                        <group>
                            <field name="dive_spec_cfps" string="CFPS"/>
                            <field name="dive_cfps_end" string="Fin validite CFPS"/>
                            <field name="dive_spec_ve" string="VE"/>
                            <field name="dive_spec_pn" string="PN"/>
                        </group>
                        <group>
                            <field name="dive_spec_pnc" string="PNC"/>
                            <field name="dive_spec_in" string="IN"/>
                            <field name="dive_spec_inc" string="INC"/>
                            <field name="dive_spec_fn" string="FN"/>
                            <field name="dive_other_brevets"/>
                        </group>
                    </group>
                    <group string="Autres federations">
                        <group>
                            <field name="dive_fed_adip"/>
                            <field name="dive_fed_cedip"/>
                            <field name="dive_fed_ida"/>
                        </group>
                        <group>
                            <field name="dive_fed_protec"/>
                            <field name="dive_fed_ssi"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_dive" model="ir.ui.view">
        <field name="name">res.partner.form.dive.club</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Club Plongee" name="dive_club" invisible="is_company">
                    <group>
                        <group string="Identite">
                            <field name="dive_firstname"/>
                            <field name="dive_lastname"/>
                            <field name="dive_gender"/>
                            <field name="dive_birthday"/>
                            <field name="dive_member_since"/>
                            <field name="dive_profession"/>
                            <field name="dive_is_plongeur"/>
                            <field name="dive_is_hsa"/>
                        </group>
                        <group string="Telephones">
                            <field name="dive_phone_home"/>
                            <field name="dive_phone_work"/>
                        </group>
                    </group>
                    <group>
                        <group string="LIFRAS">
                            <field name="dive_brevet"/>
                            <field name="dive_brevet_rank" invisible="1"/>
                            <field name="dive_lifras_id"/>
                        </group>
                        <group string="Urgence / Medical">
                            <field name="dive_contact_name"/>
                            <field name="dive_contact_phone"/>
                            <field name="dive_last_medical"/>
                            <field name="dive_last_ecg"/>
                        </group>
                    </group>
                    <group string="Brevets">
                        <group>
                            <field name="dive_brevet_date_1"/>
                            <field name="dive_brevet_date_2"/>
                            <field name="dive_brevet_date_3"/>
                            <field name="dive_brevet_date_4"/>
                        </group>
                        <group>
                            <field name="dive_brevet_date_am"/>
                            <field name="dive_brevet_date_mc"/>
                            <field name="dive_brevet_date_mf"/>
                            <field name="dive_brevet_date_mn"/>
                        </group>
                    </group>
                    <group string="Specialites">
                        <group>
                            <field name="dive_spec_cfps" string="CFPS"/>
                            <field name="dive_cfps_end" string="Fin validite CFPS"/>
                            <field name="dive_spec_ve" string="VE"/>
                            <field name="dive_spec_pn" string="PN"/>
                        </group>
                        <group>
                            <field name="dive_spec_pnc" string="PNC"/>
                            <field name="dive_spec_in" string="IN"/>
                            <field name="dive_spec_inc" string="INC"/>
                            <field name="dive_spec_fn" string="FN"/>
                            <field name="dive_other_brevets"/>
                        </group>
                    </group>
                    <group string="Autres federations">
                        <group>
                            <field name="dive_fed_adip"/>
                            <field name="dive_fed_cedip"/>
                            <field name="dive_fed_ida"/>
                        </group>
                        <group>
                            <field name="dive_fed_protec"/>
                            <field name="dive_fed_ssi"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
