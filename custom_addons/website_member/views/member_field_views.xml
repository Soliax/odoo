<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_member_directory_field_tree" model="ir.ui.view">
        <field name="name">member.directory.field.list</field>
        <field name="model">member.directory.field</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section"/>
                <field name="source_model"/>
                <field name="field_name"/>
                <field name="widget"/>
                <field name="visibility"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_member_directory_field_form" model="ir.ui.view">
        <field name="name">member.directory.field.form</field>
        <field name="model">member.directory.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="section"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="source_model"/>
                            <field name="field_name"/>
                            <field name="widget"/>
                            <field name="visibility"/>
                            <field name="group_ids" widget="many2many_tags" invisible="visibility != 'group'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_member_directory_field" model="ir.actions.act_window">
        <field name="name">Profile Fields</field>
        <field name="res_model">member.directory.field</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_member_directory_root"
              name="Members"
              parent="website.menu_website_configuration"
              sequence="60"
              groups="website_member.group_member_directory_manager"/>

    <menuitem id="menu_member_directory_fields"
              name="Profile Fields"
              parent="menu_member_directory_root"
              action="action_member_directory_field"
              sequence="10"/>
</odoo>
