<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_member_section_list" model="ir.ui.view">
        <field name="name">member.section.list</field>
        <field name="model">member.section</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="field_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_member_section_form" model="ir.ui.view">
        <field name="name">member.section.form</field>
        <field name="model">member.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Fields">
                        <field name="field_ids" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="field_name"/>
                                <field name="widget_id"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_member_widget_list" model="ir.ui.view">
        <field name="name">member.widget.list</field>
        <field name="model">member.widget</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="render_type"/>
                <field name="is_system"/>
                <field name="field_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_member_widget_form" model="ir.ui.view">
        <field name="name">member.widget.form</field>
        <field name="model">member.widget</field>
        <field name="arch" type="xml">
            <form string="Profile Widget">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="is_system"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="render_type" readonly="is_system"/>
                            <field name="is_system" readonly="1"/>
                            <field name="uses_value_list"/>
                            <field name="field_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Value list" name="values"
                              invisible="not uses_value_list">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="value"/>
                                    <field name="short_name"/>
                                    <field name="css_class"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Used by fields" name="fields">
                            <field name="field_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="section_id"/>
                                    <field name="field_name"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_member_directory_field_tree" model="ir.ui.view">
        <field name="name">member.field.list</field>
        <field name="model">member.field</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="section_id"/>
                <field name="source_model"/>
                <field name="field_name"/>
                <field name="widget_id"/>
                <field name="is_custom" optional="show" readonly="1"/>
                <field name="show_on_backend" optional="show"/>
                <field name="visibility"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_member_directory_field_form" model="ir.ui.view">
        <field name="name">member.field.form</field>
        <field name="model">member.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="section_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="source_model"/>
                            <field name="field_name"/>
                            <field name="widget_id"/>
                            <field name="is_custom" readonly="1"/>
                            <field name="show_on_backend"/>
                            <field name="visibility"/>
                            <field name="group_ids" widget="many2many_tags" invisible="visibility != 'group'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_member_field_create_wizard_form" model="ir.ui.view">
        <field name="name">member.field.create.wizard.form</field>
        <field name="model">member.field.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create technical field">
                <group>
                    <field name="name"/>
                    <field name="section_id"/>
                    <field name="widget_id"
                           options="{'no_create_edit': False}"/>
                    <field name="field_type"
                           help="Inferred from the widget (Select → dropdown, MultiSelect → tags)."/>
                    <field name="technical_name"/>
                    <field name="sequence"/>
                    <field name="show_on_profile"/>
                    <field name="show_on_backend"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_member_technical_field_list" model="ir.ui.view">
        <field name="name">member.field.technical.list</field>
        <field name="model">member.field</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="true">
                <header>
                    <button name="%(website_member.action_member_field_create_wizard)d"
                            type="action"
                            string="New technical field" class="btn-primary"
                            display="always"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="field_name"/>
                <field name="section_id"/>
                <field name="widget_id"/>
                <field name="show_on_backend"/>
                <field name="visibility"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_member_technical_field_form" model="ir.ui.view">
        <field name="name">member.field.technical.form</field>
        <field name="model">member.field</field>
        <field name="arch" type="xml">
            <form string="Technical Field" create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_widget" type="object"
                                class="oe_stat_button" icon="fa-tags"
                                invisible="not widget_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Widget / values</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Profile">
                            <field name="name"/>
                            <field name="section_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="show_on_backend"/>
                            <field name="visibility"/>
                            <field name="group_ids" widget="many2many_tags"
                                     invisible="visibility != 'group'"/>
                        </group>
                        <group string="Technical">
                            <field name="field_name"
                                     placeholder="dive_brevet_pa"/>
                            <field name="source_model" readonly="1"/>
                            <field name="widget_id"/>
                            <field name="is_custom" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_member_directory_field" model="ir.actions.act_window">
        <field name="name">Profile Fields</field>
        <field name="res_model">member.field</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_member_technical_field" model="ir.actions.act_window">
        <field name="name">Technical Fields</field>
        <field name="res_model">member.field</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_custom', '=', True)]</field>
        <field name="context">{
            'default_is_custom': True,
            'default_source_model': 'res.partner',
            'create': False,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No custom technical fields yet.
            </p>
            <p>
                Use « New technical field » on this page to create an x_ contact field,
                then edit label, technical name, section, widget and visibility here.
            </p>
        </field>
    </record>

    <record id="action_member_technical_field_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_member_technical_field_list"/>
        <field name="act_window_id" ref="action_member_technical_field"/>
    </record>

    <record id="action_member_technical_field_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_member_technical_field_form"/>
        <field name="act_window_id" ref="action_member_technical_field"/>
    </record>

    <record id="action_member_section" model="ir.actions.act_window">
        <field name="name">Profile Sections</field>
        <field name="res_model">member.section</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_member_widget" model="ir.actions.act_window">
        <field name="name">Profile Widgets</field>
        <field name="res_model">member.widget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a widget with a value list (Select / MultiSelect / LIFRAS).
            </p>
            <p>
                Built-in widgets (Text, Date, Brevets LIFRAS…) can be renamed but not deleted.
                Select, MultiSelect and Brevet LIFRAS expose an editable value list.
            </p>
        </field>
    </record>

    <record id="action_member_field_create_wizard" model="ir.actions.act_window">
        <field name="name">New technical field</field>
        <field name="res_model">member.field.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_member_directory_root"
              name="Members"
              parent="website.menu_website_configuration"
              sequence="60"
              groups="website_member.group_member_directory_manager"/>

    <menuitem id="menu_member_sections"
              name="Profile Sections"
              parent="menu_member_directory_root"
              action="action_member_section"
              sequence="5"/>

    <menuitem id="menu_member_widgets"
              name="Profile Widgets"
              parent="menu_member_directory_root"
              action="action_member_widget"
              sequence="8"/>

    <menuitem id="menu_member_directory_fields"
              name="Profile Fields"
              parent="menu_member_directory_root"
              action="action_member_directory_field"
              sequence="10"/>

    <menuitem id="menu_member_technical_fields"
              name="Technical Fields"
              parent="menu_member_directory_root"
              action="action_member_technical_field"
              sequence="12"/>
</odoo>
