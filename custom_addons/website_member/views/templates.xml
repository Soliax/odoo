<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Event-style member card (same visual family as website_event cards) -->
    <template id="md_event_card" name="Member Event Card">
        <t t-set="brevet_css" t-value="member.dive_brevet_css or 'brevet-nb'"/>
        <t t-set="brevet_short" t-value="member.dive_brevet_short or 'NB'"/>
        <t t-set="card_name" t-value="member.partner_id.get_dive_display_name()"/>
        <t t-set="specialties" t-value="member.get_dive_specialties()"/>
        <t t-set="categories" t-value="member.get_dive_categories()"/>
        <t t-set="profile_href" t-value="False if disable_card_link else ('/membres/%s' % member.id)"/>
        <a t-if="profile_href"
           t-att-href="profile_href"
           t-attf-class="s_md_event_card s_md_#{brevet_css} text-decoration-none text-reset">
            <t t-call="website_member.md_event_card_inner"/>
        </a>
        <div t-else="" t-attf-class="s_md_event_card s_md_#{brevet_css}">
            <t t-call="website_member.md_event_card_inner"/>
        </div>
    </template>

    <template id="md_event_card_inner" name="Member Event Card Inner">
        <article class="card h-100 s_md_event_card_article">
            <header class="card-header overflow-hidden p-0 border-0 rounded-0 s_md_event_card_header">
                <div class="s_md_event_card_cover position-relative">
                    <div t-if="categories"
                         class="s_md_event_card_cats position-absolute o_not_editable">
                        <t t-foreach="categories" t-as="cat">
                            <div t-attf-class="s_md_event_card_cat s_md_event_card_cat_#{cat['code']}"
                                 t-att-title="cat['label']">
                                <div class="s_md_card_stat_face">
                                    <img t-if="cat['code'] == 'hsa'"
                                         src="/website_member/static/src/img/icons/hsa.png"
                                         alt="HSA"/>
                                    <img t-else=""
                                         src="/website_member/static/src/img/icons/diving.png"
                                         alt="Plongeur"/>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="s_md_event_card_avatar">
                        <div class="s_md_card_oval_wrap">
                            <div class="s_md_ornament s_md_ornament_oval" aria-hidden="true"/>
                            <div class="s_md_card_oval">
                                <img t-if="member.image_128"
                                     t-att-src="'/web/image/res.users/%s/image_128' % member.id"
                                     class="s_md_card_face" alt="" loading="lazy" decoding="async"/>
                                <div t-else="" class="s_md_card_face s_md_card_face_fallback"
                                     t-esc="(card_name or '?')[:1].upper()"/>
                            </div>
                        </div>
                    </div>
                    <div class="s_md_event_card_badge position-absolute shadow-sm o_not_editable"
                         t-att-title="member.dive_brevet_label or brevet_short">
                        <span class="s_md_event_card_badge_label">Brevet</span>
                        <span class="s_md_event_card_badge_value" t-esc="brevet_short"/>
                    </div>
                </div>
            </header>
            <main class="card-body position-relative d-flex flex-column gap-2 py-3">
                <div t-if="specialties"
                     class="d-flex flex-wrap gap-1 small s_md_event_card_tags">
                    <t t-foreach="specialties" t-as="spec">
                        <span t-attf-class="s_md_spec_pill s_md_#{spec['css']}"
                              t-att-title="('%s - %s') % (spec['label'], spec['date'])"
                              t-esc="spec['short']"/>
                    </t>
                </div>
                <h5 class="card-title my-1 s_md_event_card_title">
                    <span t-if="member.dive_gender == 'F'"
                          class="s_md_gender_icon s_md_gender_f fa fa-venus"
                          title="Femme" aria-label="Femme"/>
                    <span t-elif="member.dive_gender == 'M'"
                          class="s_md_gender_icon s_md_gender_m fa fa-mars"
                          title="Homme" aria-label="Homme"/>
                    <t t-esc="card_name"/>
                </h5>
                <small class="o_not_editable fw-bold s_md_event_card_meta mt-auto">
                    <i class="fa fa-map-marker me-2 text-muted" title="Club"/>
                    <t t-esc="member.partner_id.city or 'Waterloo Diving Club'"/>
                </small>
            </main>
        </article>
    </template>

    <!-- Reusable TCG member card (expects member = res.users) -->
    <template id="md_tcg_card" name="Member TCG Card">
        <t t-set="brevet_css" t-value="member.dive_brevet_css or 'brevet-nb'"/>
        <t t-set="brevet_short" t-value="member.dive_brevet_short or 'NB'"/>
        <t t-set="card_name" t-value="member.partner_id.get_dive_display_name()"/>
        <t t-set="specialties" t-value="member.get_dive_specialties() if show_specialties is not False else []"/>
        <t t-set="profile_href" t-value="False if disable_card_link else ('/membres/%s' % member.id)"/>
        <a t-if="profile_href"
           t-att-href="profile_href"
           t-attf-class="s_md_card s_md_#{brevet_css}">
            <t t-call="website_member.md_tcg_card_inner"/>
        </a>
        <div t-else="" t-attf-class="s_md_card s_md_#{brevet_css}">
            <t t-call="website_member.md_tcg_card_inner"/>
        </div>
    </template>

    <template id="md_tcg_card_inner" name="Member TCG Card Inner">
        <div class="s_md_card_shell">
            <div class="s_md_ornament s_md_ornament_card" aria-hidden="true"/>
            <div class="s_md_ornament s_md_ornament_card_bl" aria-hidden="true"/>
            <div class="s_md_ornament s_md_ornament_card_tr" aria-hidden="true"/>
            <div class="s_md_card_gem" t-att-title="member.dive_brevet_label or brevet_short">
                <div class="s_md_card_gem_fill" aria-hidden="true"/>
                <div class="s_md_ornament s_md_ornament_gem" aria-hidden="true"/>
                <span t-esc="brevet_short"/>
            </div>

            <div class="s_md_card_art">
                <div class="s_md_card_oval_wrap">
                    <div class="s_md_ornament s_md_ornament_oval" aria-hidden="true"/>
                    <div class="s_md_card_oval">
                        <img t-if="member.image_128"
                             t-att-src="'/web/image/res.users/%s/image_128' % member.id"
                             class="s_md_card_face" alt="" loading="lazy" decoding="async"/>
                        <div t-else="" class="s_md_card_face s_md_card_face_fallback"
                             t-esc="(card_name or '?')[:1].upper()"/>
                    </div>
                </div>
            </div>

            <div class="s_md_card_panels">
                <div class="s_md_card_banner">
                    <div t-if="member.dive_is_hsa" class="s_md_card_stat s_md_card_stat_hsa" title="HSA">
                        <div class="s_md_ornament s_md_ornament_stat" aria-hidden="true"/>
                        <div class="s_md_card_stat_face">
                            <img src="/website_member/static/src/img/icons/hsa.png" alt="HSA"/>
                        </div>
                    </div>
                    <div t-if="member.dive_is_plongeur" class="s_md_card_stat s_md_card_stat_dive" title="Plongeur">
                        <div class="s_md_ornament s_md_ornament_stat" aria-hidden="true"/>
                        <div class="s_md_card_stat_face">
                            <img src="/website_member/static/src/img/icons/diving.png" alt="Plongeur"/>
                        </div>
                    </div>
                    <div class="s_md_ornament s_md_ornament_name" aria-hidden="true"/>
                    <span class="s_md_card_name">
                        <span t-if="member.dive_gender == 'F'"
                              class="s_md_gender_icon s_md_gender_f fa fa-venus"
                              title="Femme" aria-label="Femme"/>
                        <span t-elif="member.dive_gender == 'M'"
                              class="s_md_gender_icon s_md_gender_m fa fa-mars"
                              title="Homme" aria-label="Homme"/>
                        <t t-esc="card_name"/>
                    </span>
                </div>
                <div class="s_md_card_rarity" aria-hidden="true"/>
                <div class="s_md_card_text">
                    <div class="s_md_ornament s_md_ornament_specs" aria-hidden="true"/>
                    <div t-if="specialties" class="s_md_card_pills">
                        <t t-foreach="specialties" t-as="spec">
                            <span t-attf-class="s_md_spec_pill s_md_#{spec['css']}"
                                  t-att-title="('%s - %s') % (spec['label'], spec['date'])"
                                  t-esc="spec['short']"/>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Compact attendee row — same profile URL as members -->
    <template id="md_attendee_row" name="Event Attendee Row">
        <t t-set="href" t-value="card.get('profile_url') or False"/>
        <t t-set="tickets" t-value="card.get('ticket_count') or 1"/>
        <a t-if="href"
           t-att-href="href"
           t-attf-class="s_md_attendee s_md_#{card['brevet_css']} text-decoration-none">
            <t t-call="website_member.md_attendee_row_inner"/>
        </a>
        <div t-else=""
             t-attf-class="s_md_attendee s_md_attendee_nolink s_md_#{card['brevet_css']}">
            <t t-call="website_member.md_attendee_row_inner"/>
        </div>
    </template>

    <template id="md_attendee_row_inner" name="Event Attendee Row Inner">
        <span t-if="tickets > 0" class="s_md_attendee_tickets"
              t-att-title="'%s inscription(s)' % tickets"
              t-esc="tickets"/>
        <div class="s_md_attendee_gem" t-att-title="card.get('brevet_label') or card['brevet_short']">
            <div class="s_md_attendee_gem_fill" aria-hidden="true"/>
            <div class="s_md_ornament s_md_ornament_gem" aria-hidden="true"/>
            <span t-esc="card['brevet_short']"/>
        </div>
        <div class="s_md_attendee_face_wrap">
            <div class="s_md_ornament s_md_ornament_oval" aria-hidden="true"/>
            <div class="s_md_attendee_face">
                <img t-if="card.get('image_url')"
                     t-att-src="card['image_url']"
                     alt=""/>
                <span t-else="" t-esc="(card['name'] or '?')[:1].upper()"/>
            </div>
        </div>
        <div class="s_md_attendee_mid">
            <span class="s_md_attendee_name" t-esc="card['name']"/>
        </div>
    </template>

    <!--
        Members directory as a real website.page (drop zones + Members block).
        No default Intro title — the block topbar shows "Members" like Events.
    -->
    <template id="members_list" name="Members">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure o_website_member">

                <section class="s_md_members pt48 pb64"
                         data-md-options="1"
                         data-show-brevets-filters="1"
                         data-show-specialties-filters="1"
                         data-show-categories-filters="1"
                         data-tcg-visual="0"
                         data-columns="4"
                         data-limit="24"
                         data-snippet="s_md_members"
                         data-name="Members">
                    <div class="container">
                        <div class="s_md_members_content o_not_editable" data-oe-protected="true" contenteditable="false">
                            <div class="s_md_snippet_placeholder text-center text-muted py-5">
                                Les cartes membres se chargent ici…
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <record id="members_page" model="website.page">
        <field name="name">Membres</field>
        <field name="url">/membres</field>
        <field name="view_id" ref="members_list"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="False"/>
        <field name="track" eval="True"/>
    </record>

    <!--
        Member profile as an editable website template (#wrap.oe_structure),
        same pattern as members_list / website_wdc.formation. Dynamic data lives
        in the Member Profile snippet; editors can drop other blocks around it.
    -->
    <template id="member_profile" name="Member Profile">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure o_website_member o_member_profile">

                <section class="s_md_member_profile"
                         data-md-options="1"
                         data-show-fields="1"
                         data-show-events="1"
                         data-snippet="s_md_member_profile"
                         data-name="Member Profile">
                    <div class="s_md_member_profile_content o_not_editable"
                         data-oe-protected="true" contenteditable="false">
                        <div class="s_md_snippet_placeholder text-center text-muted py-5">
                            Le profil membre se charge ici…
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <template id="members_forbidden" name="Members Forbidden">
        <t t-call="website.layout">
            <div id="wrap" class="o_website_member">
                <div class="container py-5 text-center">
                    <h1 class="h3 mb-3">Acces reserve</h1>
                    <p class="text-muted mb-4">Vous devez etre connecte pour consulter les membres.</p>
                    <a class="btn btn-primary" href="/web/login?redirect=/membres">Se connecter</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
