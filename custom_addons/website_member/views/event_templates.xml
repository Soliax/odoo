<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Style → Sidebar Blocks → Participants (last sidebar block) -->
    <template id="opt_event_participants_block" name="Participants"
              inherit_id="website_event.event_description_full" active="True"/>

    <template id="event_description_participants" inherit_id="website_event.event_description_full">
        <xpath expr="//t[@t-set='opt_event_share_block']" position="after">
            <t t-set="opt_event_participants_block"
               t-value="is_view_active('website_member.opt_event_participants_block')"/>
        </xpath>

        <xpath expr="//aside[@id='o_wevent_event_main_sidebar']" position="attributes">
            <attribute name="t-if">opt_event_registration_block or opt_event_dates_block or opt_event_calendar_block or opt_event_location_block or opt_event_organizer_block or opt_event_share_block or opt_event_participants_block</attribute>
        </xpath>

        <!-- Last sidebar block (after Share) -->
        <xpath expr="//aside[@id='o_wevent_event_main_sidebar']/div[@t-if='opt_event_share_block']" position="after">
            <div t-if="opt_event_participants_block"
                 class="o_wevent_sidebar_block o_wevent_bordered_block pb-3 mb-4 s_md_event_attendees o_website_member"
                 t-att-data-event-id="event.id"
                 data-limit="0"
                 data-published-only="1"
                 data-snippet="s_md_event_attendees"
                 data-name="Participants">
                <div class="s_md_attendees_header d-flex align-items-baseline justify-content-between gap-2">
                    <h6 class="o_wevent_sidebar_title mb-0">
                        Participants
                        <span class="s_md_attendees_count text-muted fw-normal"/>
                    </h6>
                </div>
                <div class="s_md_attendees_content o_not_editable mt-2" data-oe-protected="true">
                    <div class="s_md_snippet_placeholder text-center text-muted py-3 mb-0">
                        Les participants se chargent ici…
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
