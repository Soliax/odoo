<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_md_members" name="Members">
        <section class="s_md_members pt48 pb48"
                 data-show-filters="1"
                 data-show-specialties="1"
                 data-columns="4"
                 data-limit="0"
                 data-category=""
                 data-snippet="s_md_members"
                 data-name="Members">
            <div class="container">
                <div class="s_md_members_title mb-4">
                    <h2 class="h3 mb-1">Membres</h2>
                    <p class="text-muted mb-0">Annuaire du club</p>
                </div>
                <div class="s_md_members_content">
                    <div class="s_md_snippet_placeholder text-center text-muted py-5">
                        Les cartes membres se chargent ici…
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_md_members_content" name="Members Snippet Content">
        <t t-if="show_filters">
            <form class="s_md_filters_bar s_md_filters_bar_snippet mb-4" data-md-filters="1">
                <input type="search" name="search" class="form-control s_md_filter_search"
                       placeholder="Nom..." t-att-value="search" autocomplete="off"/>
                <select name="brevet" class="form-select s_md_filter_select">
                    <option value="">Brevet</option>
                    <t t-foreach="brevet_choices" t-as="opt">
                        <option t-att-value="opt[0]"
                                t-att-selected="brevet == opt[0] and 'selected' or None"
                                t-esc="opt[1]"/>
                    </t>
                </select>
                <select name="specialty" class="form-select s_md_filter_select">
                    <option value="">Specialite</option>
                    <t t-foreach="specialty_choices" t-as="opt">
                        <option t-att-value="opt[0]"
                                t-att-selected="specialty == opt[0] and 'selected' or None"
                                t-esc="opt[1]"/>
                    </t>
                </select>
                <select name="category" class="form-select s_md_filter_select">
                    <option value="" t-att-selected="not category and 'selected' or None">Categorie</option>
                    <option value="plongeur" t-att-selected="category == 'plongeur' and 'selected' or None">Plongeur</option>
                    <option value="hsa" t-att-selected="category == 'hsa' and 'selected' or None">HSA</option>
                </select>
            </form>
        </t>
        <t t-if="not members">
            <div class="alert alert-light border text-center py-4 mb-0">
                Aucun membre ne correspond a ces filtres.
            </div>
        </t>
        <div t-else="" t-attf-class="s_md_tcg_grid s_md_cols_#{columns}">
            <t t-foreach="members" t-as="member">
                <t t-call="website_member.md_tcg_card">
                    <t t-set="show_specialties" t-value="show_specialties"/>
                </t>
            </t>
        </div>
    </template>
</odoo>
