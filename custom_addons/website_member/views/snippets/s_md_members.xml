<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_md_members" name="Members">
        <section class="s_md_members pt48 pb48"
                 data-md-options="1"
                 data-show-brevets-filters="1"
                 data-show-specialties-filters="1"
                 data-show-categories-filters="1"
                 data-tcg-visual="0"
                 data-columns="4"
                 data-limit="0"
                 data-snippet="s_md_members"
                 data-name="Members">
            <div class="container">
                <div class="s_md_members_content o_not_editable"
                     data-oe-protected="true" contenteditable="false">
                    <div class="s_md_snippet_placeholder text-center text-muted py-5">
                        Les cartes membres se chargent ici…
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Events-like topbar: title left, filters + search right -->
    <template id="s_md_members_filters" name="Members Filters Bar">
        <form class="s_md_filters s_md_filters_bar mb-3" data-md-filters="1">
            <div class="s_md_filters_bar_row d-flex d-print-none align-items-center flex-wrap gap-2">
                <h1 class="s_md_filters_title me-auto mb-0 h4-fs">Members</h1>
                <div t-if="show_brevets_filters" class="dropdown">
                    <button type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false">
                        Brevets
                        <span class="badge bg-primary ms-1 s_md_filter_count d-none" data-md-count="brevet"/>
                    </button>
                    <div class="dropdown-menu p-2 s_md_filter_dropdown">
                        <t t-foreach="brevet_choices" t-as="opt">
                            <label class="s_md_filter_check">
                                <input type="checkbox" name="brevet" t-att-value="opt[0]"/>
                                <span t-esc="opt[1]"/>
                            </label>
                        </t>
                    </div>
                </div>
                <div t-if="show_specialties_filters" class="dropdown">
                    <button type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false">
                        Spécialités
                        <span class="badge bg-primary ms-1 s_md_filter_count d-none" data-md-count="specialty"/>
                    </button>
                    <div class="dropdown-menu p-2 s_md_filter_dropdown">
                        <t t-foreach="specialty_choices" t-as="opt">
                            <label class="s_md_filter_check">
                                <input type="checkbox" name="specialty" t-att-value="opt[0]"/>
                                <span t-esc="opt[1]"/>
                            </label>
                        </t>
                    </div>
                </div>
                <div t-if="show_categories_filters" class="dropdown">
                    <button type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false">
                        Catégories
                        <span class="badge bg-primary ms-1 s_md_filter_count d-none" data-md-count="category"/>
                    </button>
                    <div class="dropdown-menu p-2 s_md_filter_dropdown">
                        <label class="s_md_filter_check">
                            <input type="checkbox" name="category" value="plongeur"/>
                            <span>Plongeur</span>
                        </label>
                        <label class="s_md_filter_check">
                            <input type="checkbox" name="category" value="hsa"/>
                            <span>HSA</span>
                        </label>
                    </div>
                </div>
                <div class="dropdown">
                    <button type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Trier
                    </button>
                    <div class="dropdown-menu p-2 s_md_filter_dropdown s_md_sort_dropdown">
                        <label class="s_md_filter_check">
                            <input type="radio" name="sort" value="name_asc"
                                   t-att-checked="sort == 'name_asc'"/>
                            <span>Nom de famille A → Z</span>
                        </label>
                        <label class="s_md_filter_check">
                            <input type="radio" name="sort" value="name_desc"
                                   t-att-checked="sort == 'name_desc'"/>
                            <span>Nom de famille Z → A</span>
                        </label>
                        <label class="s_md_filter_check">
                            <input type="radio" name="sort" value="brevet_asc"
                                   t-att-checked="sort == 'brevet_asc'"/>
                            <span>Brevet ↑ (NB → MN)</span>
                        </label>
                        <label class="s_md_filter_check">
                            <input type="radio" name="sort" value="brevet_desc"
                                   t-att-checked="(not sort) or sort == 'brevet_desc'"/>
                            <span>Brevet ↓ (MN → NB)</span>
                        </label>
                    </div>
                </div>
                <div class="s_md_filters_search input-group">
                    <input type="search" name="search" class="form-control s_md_filter_search"
                           placeholder="Rechercher un membre..." autocomplete="off"/>
                    <span class="input-group-text s_md_filters_search_icon" aria-hidden="true">
                        <i class="oi oi-search"/>
                    </span>
                </div>
            </div>
        </form>
    </template>

    <template id="s_md_members_results" name="Members Results">
        <t t-if="not members">
            <div class="alert alert-light border text-center py-4 mb-0">
                Aucun membre ne correspond a ces filtres.
            </div>
        </t>
        <div t-elif="tcg_visual" t-attf-class="s_md_tcg_grid s_md_cols_#{columns}">
            <t t-foreach="members" t-as="member">
                <t t-call="website_member.md_tcg_card">
                    <t t-set="show_specialties" t-value="True"/>
                </t>
            </t>
        </div>
        <div t-else="" t-attf-class="s_md_event_grid s_md_cols_#{columns}">
            <t t-foreach="members" t-as="member">
                <t t-call="website_member.md_event_card"/>
            </t>
        </div>
    </template>

    <template id="s_md_members_content" name="Members Snippet Content">
        <t t-call="website_member.s_md_members_filters"/>
        <div class="s_md_members_results">
            <t t-call="website_member.s_md_members_results"/>
        </div>
    </template>
</odoo>
