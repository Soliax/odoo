<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="website_member.MdMembersOption">
    <!-- No BuilderContext reload — Members interaction watches data-* via MutationObserver -->
    <BuilderRow label.translate="Brevets Filters">
        <BuilderCheckbox dataAttributeAction="'showBrevetsFilters'"
                         dataAttributeActionValue="'1'"/>
    </BuilderRow>
    <BuilderRow label.translate="Specialties Filters">
        <BuilderCheckbox dataAttributeAction="'showSpecialtiesFilters'"
                         dataAttributeActionValue="'1'"/>
    </BuilderRow>
    <BuilderRow label.translate="Categories Filters">
        <BuilderCheckbox dataAttributeAction="'showCategoriesFilters'"
                         dataAttributeActionValue="'1'"/>
    </BuilderRow>
    <BuilderRow label.translate="TCG Visual">
        <BuilderCheckbox dataAttributeAction="'tcgVisual'"
                         dataAttributeActionValue="'1'"/>
    </BuilderRow>
</t>

<t t-name="website_member.MdMemberProfileOption">
    <BuilderRow label.translate="Fields Sections">
        <BuilderCheckbox dataAttributeAction="'showFields'"
                         dataAttributeActionValue="'1'"/>
    </BuilderRow>
    <BuilderRow label.translate="Events List">
        <BuilderCheckbox dataAttributeAction="'showEvents'"
                         dataAttributeActionValue="'1'"/>
    </BuilderRow>
    <BuilderRow label.translate="Fixed Member" preview="false">
        <BuilderMany2One
            model="'res.users'"
            dataAttributeAction="'userId'"
            fields="['id', 'name']"
            domain="[['share', '=', false], ['members_published', '=', true]]"
            limit="20"
        />
    </BuilderRow>
</t>

<t t-name="website_member.MdAttendeesOption">
    <BuilderContext action="'reloadMdSnippet'" preview="false">
        <BuilderRow label.translate="Event" preview="false">
            <BuilderMany2One
                model="'event.event'"
                dataAttributeAction="'eventId'"
                fields="['id', 'name']"
                limit="20"
            />
        </BuilderRow>
        <BuilderRow label.translate="Published Members Only">
            <BuilderCheckbox dataAttributeAction="'publishedOnly'"
                             dataAttributeActionValue="'1'"/>
        </BuilderRow>
        <BuilderRow label.translate="Max Rows">
            <BuilderSelect dataAttributeAction="'limit'">
                <BuilderSelectItem dataAttributeActionValue="'0'">All</BuilderSelectItem>
                <BuilderSelectItem dataAttributeActionValue="'5'">5</BuilderSelectItem>
                <BuilderSelectItem dataAttributeActionValue="'10'">10</BuilderSelectItem>
                <BuilderSelectItem dataAttributeActionValue="'20'">20</BuilderSelectItem>
                <BuilderSelectItem dataAttributeActionValue="'50'">50</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </BuilderContext>
</t>

<!-- Event Page Style: Participants as last Sidebar Block -->
<t t-name="website_event.EventMainPageOption" t-inherit="website_event.EventMainPageOption" t-inherit-mode="extension">
    <xpath expr="//BuilderRow[@label.translate='Share']" position="after">
        <BuilderRow label.translate="Participants" level="1">
            <BuilderCheckbox actionParam="{views: ['website_member.opt_event_participants_block']}"/>
        </BuilderRow>
    </xpath>
</t>
</templates>
