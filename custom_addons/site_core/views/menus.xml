<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_site_core_tree" model="ir.ui.view">
        <field name="name">site_core.site_core.list</field>
        <field name="model">site_core.site_core</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_site_core_form" model="ir.ui.view">
        <field name="name">site_core.site_core.form</field>
        <field name="model">site_core.site_core</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_site_core" model="ir.actions.act_window">
        <field name="name">Site Core</field>
        <field name="res_model">site_core.site_core</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_site_core_root" name="Site Core" sequence="100"/>
    <menuitem id="menu_site_core" name="Site Core" parent="menu_site_core_root" action="action_site_core" sequence="10"/>
</odoo>
