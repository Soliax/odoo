<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="members_list" name="Members List">
        <t t-call="website.layout">
            <div id="wrap" class="o_member_directory">
                <div class="oe_structure">
                    <section class="s_md_hero pt64 pb32">
                        <div class="container">
                            <div class="row align-items-end g-3">
                                <div class="col-lg-7">
                                    <p class="s_md_kicker mb-2">Club de plongee</p>
                                    <h1 class="display-5 mb-2">Membres</h1>
                                    <p class="lead text-muted mb-0" t-esc="intro"/>
                                </div>
                                <div class="col-lg-5">
                                    <form action="/membres" method="get" class="s_md_search">
                                        <div class="input-group">
                                            <input type="search" name="search" class="form-control form-control-lg"
                                                   placeholder="Rechercher un membre..." t-att-value="search"/>
                                            <button class="btn btn-primary btn-lg" type="submit">Rechercher</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="pb64">
                        <div class="container">
                            <t t-if="not members">
                                <div class="alert alert-light border text-center py-5">
                                    <p class="mb-0">Aucun membre disponible pour le moment.</p>
                                </div>
                            </t>
                            <div t-else="" class="row g-4 s_md_grid">
                                <t t-foreach="members" t-as="member">
                                    <t t-set="brevet_css" t-value="member.dive_brevet_css or 'brevet-none'"/>
                                    <t t-set="specialties" t-value="member.get_dive_specialties()"/>
                                    <t t-set="has_hsa" t-value="member.has_directory_hsa_affiliation()"/>
                                    <t t-set="has_diving" t-value="member.has_directory_diving_affiliation()"/>
                                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                        <a t-att-href="'/membres/%s' % member.id"
                                           t-attf-class="s_md_card text-decoration-none s_md_#{brevet_css}">
                                            <div class="s_md_card_inner">
                                                <span class="s_md_card_glow"/>
                                                <div t-if="member.dive_brevet_short" class="s_md_brevet_diamond" t-att-title="member.dive_brevet_label or member.dive_brevet_short">
                                                    <span t-esc="member.dive_brevet_short"/>
                                                </div>
                                                <div class="s_md_avatar_wrap">
                                                    <img t-if="member.image_128"
                                                         t-att-src="'/web/image/res.users/%s/image_128' % member.id"
                                                         class="s_md_avatar"
                                                         t-att-alt="'Portrait de %s' % (member.get_directory_card_name() or 'membre')"/>
                                                    <div t-else="" class="s_md_avatar s_md_avatar_fallback">
                                                        <span t-esc="(member.get_directory_card_name() or '?')[:1].upper()"/>
                                                    </div>
                                                </div>
                                                <div class="s_md_nameplate">
                                                    <h3 class="s_md_name" t-esc="member.get_directory_card_name()"/>
                                                    <p class="s_md_subtitle">
                                                        <t t-if="member.directory_subtitle" t-esc="member.directory_subtitle"/>
                                                        <t t-elif="member.partner_id.function" t-esc="member.partner_id.function"/>
                                                        <t t-elif="member.dive_brevet_label" t-esc="member.dive_brevet_label"/>
                                                    </p>
                                                </div>
                                                <div class="s_md_specs_panel">
                                                    <div t-if="specialties" class="s_md_spec_pills">
                                                        <t t-foreach="specialties" t-as="spec">
                                                            <span t-attf-class="s_md_spec_pill s_md_#{spec['css']}"
                                                                  t-att-title="('%s - depuis %s') % (spec['label'], spec['date'])"
                                                                  t-esc="spec['short']"/>
                                                        </t>
                                                    </div>
                                                    <p t-else="" class="s_md_specs_empty mb-0">Aucune specialite renseignee</p>
                                                    <div t-if="has_hsa or has_diving" class="s_md_affiliations">
                                                        <span class="s_md_affiliation_slot">
                                                            <span t-if="has_hsa" class="s_md_affiliation s_md_affiliation_hsa" title="Membre HSA" aria-label="Membre HSA">
                                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                    <path d="M7.2 5.4a1 1 0 0 1 1.4 0l2.25 2.25-1.42 1.42L7.2 6.82a1 1 0 0 1 0-1.42Zm8.2 0a1 1 0 0 1 1.4 1.42l-2.24 2.24-1.42-1.42 2.25-2.25ZM9.3 12.05l2.65-2.65 4.7 4.7-2.64 2.65-4.71-4.7Zm-3.9 5.2c1.02-1.02 2.61-1.1 3.72-.24l-3.49 3.49c-.86-1.11-.78-2.69.24-3.25ZM12.65 8.7l1.42-1.42 4.7 4.7-1.42 1.42-4.7-4.7Zm-5.9 8.8 2.9-2.9 1.9 1.9-2.9 2.9H6.75Zm10.5-1.85c.9-.9 2.28-1.03 3.33-.4l-3.13 3.13c-.63-1.05-.5-2.43.4-3.33Z"/>
                                                                    <circle cx="18.2" cy="18.2" r="1.75"/>
                                                                </svg>
                                                            </span>
                                                        </span>
                                                        <span class="s_md_affiliation_slot s_md_affiliation_slot_end">
                                                            <span t-if="has_diving" class="s_md_affiliation s_md_affiliation_diving" title="Section plongee" aria-label="Section plongee">
                                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                                    <path d="M9.5 3.5A2.5 2.5 0 0 0 7 6v6.5a2.5 2.5 0 0 0 2.5 2.5h.75V18a1 1 0 0 0 1 1h1.5a1 1 0 0 0 1-1v-3h.75A2.5 2.5 0 0 0 17 12.5V6a2.5 2.5 0 0 0-2.5-2.5h-5Zm1.75 2h1.5a.75.75 0 1 1 0 1.5h-1.5a.75.75 0 0 1 0-1.5ZM6 11.25h1v1.25A3.5 3.5 0 0 0 10.5 16h3A3.5 3.5 0 0 0 17 12.5v-1.25h1a2 2 0 0 1 2 2V15a.75.75 0 0 1-.75.75H4.75A.75.75 0 0 1 4 15v-1.75a2 2 0 0 1 2-2Z"/>
                                                                </svg>
                                                            </span>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>

    <template id="member_profile" name="Members Profile">
        <t t-call="website.layout">
            <t t-set="brevet_css" t-value="member.dive_brevet_css or 'brevet-none'"/>
            <t t-set="specialties" t-value="member.get_dive_specialties()"/>
            <div t-attf-class="o_member_directory o_member_profile s_md_profile_#{brevet_css}">
                <div id="wrap">
                    <div class="oe_structure">
                        <section class="s_md_profile_hero pt48 pb32">
                            <div class="container">
                                <a href="/membres" class="s_md_back mb-4 d-inline-flex">&amp;larr; Retour aux membres</a>
                                <div t-attf-class="s_md_profile_panel s_md_#{brevet_css}">
                                    <span class="s_md_frame s_md_frame_tl"/>
                                    <span class="s_md_frame s_md_frame_tr"/>
                                    <span class="s_md_frame s_md_frame_bl"/>
                                    <span class="s_md_frame s_md_frame_br"/>
                                    <div class="row align-items-center g-4">
                                        <div class="col-auto">
                                            <div class="s_md_profile_photo_wrap">
                                                <img t-if="member.image_1920"
                                                     t-att-src="'/web/image/res.users/%s/image_1920' % member.id"
                                                     class="s_md_profile_photo" alt=""/>
                                                <div t-else="" class="s_md_profile_photo s_md_avatar_fallback">
                                                    <span t-esc="(member.get_directory_card_name() or '?')[:1].upper()"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <p class="s_md_kicker mb-2">Profil membre</p>
                                            <h1 class="display-6 mb-2" t-esc="member.get_directory_card_name()"/>
                                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                                <span t-if="member.dive_brevet_short" class="s_md_brevet_chip s_md_brevet_chip_lg" t-esc="member.dive_brevet_short"/>
                                                <span t-if="member.dive_brevet_label" class="text-muted" t-esc="member.dive_brevet_label"/>
                                            </div>
                                            <div t-if="specialties" class="s_md_spec_pills s_md_spec_pills_lg mb-2">
                                                <t t-foreach="specialties" t-as="spec">
                                                    <span t-attf-class="s_md_spec_pill s_md_#{spec['css']}"
                                                          t-att-title="spec['label']">
                                                        <t t-esc="spec['short']"/>
                                                        <small class="ms-1 opacity-75" t-esc="spec['date']"/>
                                                    </span>
                                                </t>
                                            </div>
                                            <p t-if="partner.function" class="lead text-muted mb-0" t-esc="partner.function"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="pb64">
                            <div class="container">
                                <t t-if="not sections">
                                    <div class="alert alert-light border">
                                        Aucune information supplementaire a afficher pour ce membre.
                                    </div>
                                </t>
                                <div t-else="" class="row g-4">
                                    <t t-foreach="sections" t-as="section">
                                        <div class="col-12 col-lg-6">
                                            <div class="s_md_section_card">
                                                <h2 class="h5 s_md_section_title" t-esc="section['label']"/>
                                                <dl class="s_md_fields mb-0">
                                                    <t t-foreach="section['items']" t-as="item">
                                                        <div class="s_md_field">
                                                            <dt t-esc="item['label']"/>
                                                            <dd>
                                                                <t t-set="data" t-value="item['data']"/>
                                                                <t t-if="data['type'] == 'email'">
                                                                    <a t-att-href="'mailto:%s' % data['value']" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'phone'">
                                                                    <a t-att-href="'tel:%s' % data['value']" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'url'">
                                                                    <a t-att-href="data['value']" target="_blank" rel="noopener" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'html'">
                                                                    <div t-out="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'address'">
                                                                    <span style="white-space: pre-line;" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'brevet'">
                                                                    <span t-attf-class="s_md_brevet_chip s_md_#{data.get('css')}">
                                                                        <t t-esc="data.get('short') or data['value']"/>
                                                                    </span>
                                                                    <span class="ms-2" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <span t-esc="data['value']"/>
                                                                </t>
                                                            </dd>
                                                        </div>
                                                    </t>
                                                </dl>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="members_forbidden" name="Members Forbidden">
        <t t-call="website.layout">
            <div id="wrap" class="o_member_directory">
                <div class="container py-5 text-center">
                    <h1 class="h3 mb-3">Acces reserve</h1>
                    <p class="text-muted mb-4">Vous devez etre connecte pour consulter les membres.</p>
                    <a class="btn btn-primary" href="/web/login?redirect=/membres">Se connecter</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
