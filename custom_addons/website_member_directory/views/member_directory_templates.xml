<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="members_list" name="Members List">
        <t t-call="website.layout">
            <div id="wrap" class="o_member_directory">
                <div class="oe_structure">
                    <section class="s_md_hero">
                        <div class="container">
                            <div class="s_md_hero_row">
                                <div class="s_md_hero_copy">
                                    <p class="s_md_kicker mb-2">Club de plongee</p>
                                    <h1 class="display-5 mb-2">Membres</h1>
                                    <p class="lead mb-0" t-esc="intro"/>
                                </div>
                                <form action="/membres" method="get" class="s_md_search input-group">
                                    <input type="hidden" name="category" t-att-value="category"/>
                                    <input type="search" name="search" class="form-control"
                                           placeholder="Rechercher un membre..." t-att-value="search"
                                           autocomplete="off"/>
                                    <button class="btn s_md_search_btn" type="submit">Rechercher</button>
                                </form>
                            </div>
                        </div>
                    </section>

                    <section class="s_md_toolbar">
                        <div class="container">
                            <form action="/membres" method="get" class="s_md_filters" role="group" aria-label="Categories">
                                <input type="hidden" name="search" t-att-value="search"/>
                                <button type="submit" name="category" value=""
                                        t-attf-class="s_md_filter_btn #{'is-active' if not category else ''}">Tous</button>
                                <button type="submit" name="category" value="plongeur"
                                        t-attf-class="s_md_filter_btn #{'is-active' if category == 'plongeur' else ''}">Plongeur</button>
                                <button type="submit" name="category" value="hsa"
                                        t-attf-class="s_md_filter_btn #{'is-active' if category == 'hsa' else ''}">HSA</button>
                            </form>
                        </div>
                    </section>

                    <section class="s_md_grid_section">
                        <div class="container">
                            <t t-if="not members">
                                <div class="alert alert-light border text-center py-5">
                                    <p class="mb-0">Aucun membre disponible pour le moment.</p>
                                </div>
                            </t>
                            <div t-else="" class="row g-4 s_md_grid">
                                <t t-foreach="members" t-as="member">
                                    <t t-set="brevet_css" t-value="member.dive_brevet_css or 'brevet-nb'"/>
                                    <t t-set="specialties" t-value="member.get_dive_specialties()"/>
                                    <t t-set="categories" t-value="member.get_dive_categories()"/>
                                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                        <a t-att-href="'/membres/%s' % member.id"
                                           t-attf-class="s_md_card text-decoration-none s_md_#{brevet_css}">
                                            <div class="s_md_badge">
                                                <img t-att-src="'/website_member_directory/static/src/img/badges/%s.svg' % brevet_css"
                                                     class="s_md_badge_frame" alt=""/>
                                                <div class="s_md_badge_nameplate">
                                                    <div class="s_md_badge_login" t-esc="member.login"/>
                                                    <div class="s_md_badge_name" t-esc="member.get_directory_card_name()"/>
                                                </div>
                                            </div>
                                            <div class="s_md_card_meta">
                                                <div t-if="categories" class="s_md_cat_pills">
                                                    <t t-foreach="categories" t-as="cat">
                                                        <span t-attf-class="s_md_cat_pill s_md_#{cat['css']}" t-esc="cat['short']"/>
                                                    </t>
                                                </div>
                                                <div t-if="specialties" class="s_md_spec_pills">
                                                    <t t-foreach="specialties" t-as="spec">
                                                        <span t-attf-class="s_md_spec_pill s_md_#{spec['css']}"
                                                              t-att-title="('%s - depuis %s') % (spec['label'], spec['date'])"
                                                              t-esc="spec['short']"/>
                                                    </t>
                                                </div>
                                                <span class="s_md_cta">Voir le profil</span>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </template>

    <template id="member_profile" name="Members Profile">
        <t t-call="website.layout">
            <t t-set="brevet_css" t-value="member.dive_brevet_css or 'brevet-nb'"/>
            <t t-set="specialties" t-value="member.get_dive_specialties()"/>
            <t t-set="categories" t-value="member.get_dive_categories()"/>
            <div t-attf-class="o_member_directory o_member_profile s_md_profile_#{brevet_css}">
                <div id="wrap">
                    <div class="oe_structure">
                        <section class="s_md_profile_hero">
                            <div class="container">
                                <a href="/membres" class="s_md_back mb-4 d-inline-flex">&amp;larr; Retour aux membres</a>
                                <div class="row align-items-center g-4">
                                    <div class="col-auto">
                                        <div t-attf-class="s_md_card s_md_#{brevet_css} s_md_card_static">
                                            <div class="s_md_badge s_md_badge_lg">
                                                <img t-att-src="'/website_member_directory/static/src/img/badges/%s.svg' % brevet_css"
                                                     class="s_md_badge_frame" alt=""/>
                                                <div class="s_md_badge_nameplate">
                                                    <div class="s_md_badge_login" t-esc="member.login"/>
                                                    <div class="s_md_badge_name" t-esc="member.get_directory_card_name()"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <p class="s_md_kicker mb-2">Profil membre</p>
                                        <h1 class="display-6 text-white mb-2" t-esc="member.get_directory_card_name()"/>
                                        <p t-if="member.dive_brevet_label" class="text-white-50 mb-3" t-esc="member.dive_brevet_label"/>
                                        <div t-if="categories" class="s_md_cat_pills mb-2">
                                            <t t-foreach="categories" t-as="cat">
                                                <span t-attf-class="s_md_cat_pill s_md_#{cat['css']}" t-esc="cat['label']"/>
                                            </t>
                                        </div>
                                        <div t-if="specialties" class="s_md_spec_pills s_md_spec_pills_lg">
                                            <t t-foreach="specialties" t-as="spec">
                                                <span t-attf-class="s_md_spec_pill s_md_#{spec['css']}" t-att-title="spec['label']">
                                                    <t t-esc="spec['short']"/>
                                                    <small class="ms-1 opacity-75" t-esc="spec['date']"/>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="s_md_grid_section">
                            <div class="container">
                                <t t-if="not sections">
                                    <div class="alert alert-light border">Aucune information supplementaire a afficher pour ce membre.</div>
                                </t>
                                <div t-else="" class="row g-4">
                                    <t t-foreach="sections" t-as="section">
                                        <div class="col-12 col-lg-6">
                                            <div class="s_md_section_card">
                                                <h2 class="h5 s_md_section_title" t-esc="section['label']"/>
                                                <dl class="s_md_fields mb-0">
                                                    <t t-foreach="section['items']" t-as="item">
                                                        <div class="s_md_field">
                                                            <dt t-esc="item['label']"/>
                                                            <dd>
                                                                <t t-set="data" t-value="item['data']"/>
                                                                <t t-if="data['type'] == 'email'">
                                                                    <a t-att-href="'mailto:%s' % data['value']" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'phone'">
                                                                    <a t-att-href="'tel:%s' % data['value']" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'brevet'">
                                                                    <span class="s_md_rank_code" t-esc="data.get('short') or data['value']"/>
                                                                    <span class="ms-2" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'address'">
                                                                    <span style="white-space: pre-line;" t-esc="data['value']"/>
                                                                </t>
                                                                <t t-elif="data['type'] == 'html'">
                                                                    <div t-out="data['value']"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <span t-esc="data['value']"/>
                                                                </t>
                                                            </dd>
                                                        </div>
                                                    </t>
                                                </dl>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="members_forbidden" name="Members Forbidden">
        <t t-call="website.layout">
            <div id="wrap" class="o_member_directory">
                <div class="container py-5 text-center">
                    <h1 class="h3 mb-3">Acces reserve</h1>
                    <p class="text-muted mb-4">Vous devez etre connecte pour consulter les membres.</p>
                    <a class="btn btn-primary" href="/web/login?redirect=/membres">Se connecter</a>
                </div>
            </div>
        </t>
    </template>
</odoo>
