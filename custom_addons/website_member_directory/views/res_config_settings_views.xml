<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.member.directory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Member Directory" id="member_directory_settings">
                    <setting string="Directory intro text" help="Shown above the member cards.">
                        <field name="member_directory_intro"/>
                    </setting>
                    <setting string="Anonymous visitors" help="What happens when a guest opens /membres.">
                        <field name="member_directory_deny_redirect"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
