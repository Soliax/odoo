[options]
admin_passwd = CHANGE_ME
http_port = 8069
http_interface = 127.0.0.1

db_host = 127.0.0.1
db_port = 5432
db_user = odoo
db_password = odoo

# Adjust absolute paths for your machine
addons_path = e:/Odoo/odoo/addons,e:/Odoo/custom_addons,e:/Odoo/tutorials

without_demo = False
list_db = True
limit_time_cpu = 600
limit_time_real = 1200
logfile = e:/Odoo/odoo-server.log
log_level = info
